{
  "manifest_version": 3,
  "name": "AI Chat Exporter",
  "version": "1.0.7",
  "description": "Export ChatGPT, Claude, Gemini, Grok, Muse, Perplexity and Google AI chats to Markdown, locally and privately.",
  "permissions": [
    "tabs",
    "scripting",
    "downloads",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://muse.ai/*",
    "https://www.muse.ai/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://ppl-ai-file-upload.s3.amazonaws.com/*",
    "https://www.google.com/*",
    "https://google.com/*",
    "*://*.chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://*.openai.com/*",
    "*://*.oaiusercontent.com/*",
    "*://*.claude.ai/*",
    "*://*.claude.com/*",
    "*://*.claudeusercontent.com/*",
    "*://*.anthropic.com/*",
    "*://*.gemini.google.com/*",
    "*://*.googleusercontent.com/*",
    "*://*.googleapis.com/*",
    "*://*.gstatic.com/*",
    "*://*.grok.com/*",
    "*://*.x.ai/*",
    "*://*.blob.core.windows.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://www.perplexity.ai/*", "https://perplexity.ai/*"],
    "js": ["perplexityBackground.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
